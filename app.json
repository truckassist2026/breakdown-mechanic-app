{
  "expo": {
    "name": "Truck Assist Mechanic",
    "slug": "breakdown-mechanic-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "breakdownmechanicapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.truckassist.mechanic"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F8FF",
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "cover"
        }
      ],
      "expo-status-bar",
      "expo-font",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1101e23b-9c23-4e45-9dfc-788f61273670"
      }
    },
    "owner": "truckassist2026"
  }
}
